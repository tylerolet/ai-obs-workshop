# deploy.env — committed template with safe defaults
# Copy to deploy.local.env and fill in your values. That file is gitignored.
#
#   cp deploy.env deploy.local.env
#   # edit deploy.local.env
#   ./scripts/aws-deploy.sh

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_PROFILE=default
AWS_REGION=us-east-1

# ── Cluster ───────────────────────────────────────────────────────────────────
CLUSTER_NAME=daystrom-mini
NODE_TYPE=m5.xlarge

# ── Dynatrace (optional — OTel uses debug exporter if blank) ──────────────────
# Token scopes needed: openTelemetryTrace.ingest  metrics.ingest  logs.ingest
DT_ENDPOINT=
DT_API_TOKEN=

# ── Existing VPC (leave blank to create a new VPC) ────────────────────────────
USE_EXISTING_VPC=false
EXISTING_VPC_ID=
EXISTING_PUBLIC_SUBNET_1=
EXISTING_PUBLIC_SUBNET_2=
EXISTING_PRIVATE_SUBNET_1=
EXISTING_PRIVATE_SUBNET_2=

# ── Database (leave blank to auto-generate a secure random password) ──────────
DB_PASSWORD=
